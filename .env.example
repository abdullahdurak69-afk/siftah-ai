DATABASE_URL=postgres://USER@localhost:5432/site_platform
BETTER_AUTH_SECRET=   # openssl rand -base64 32
BETTER_AUTH_URL=http://app.localhost:3000

NEXT_PUBLIC_PLATFORM_NAME=SitePlatform
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

SEED_ADMIN_EMAIL=admin@site-platform.test
SEED_ADMIN_PASSWORD=

# Domain bağlama
PLATFORM_SERVER_IP=          # sunucunun IPv4 adresi
CADDY_ASK_SECRET=            # openssl rand -hex 24
CRON_SECRET=                 # openssl rand -hex 24

# --- E-posta (davet, şifre yenileme, abonelik hatırlatmaları) ---
# Herhangi bir SMTP sağlayıcısı: Resend (smtps://resend:API_KEY@smtp.resend.com:465), Brevo, Yandex...
# Boş bırakılırsa e-postalar gönderilmez, sunucu günlüğüne yazılır.
SMTP_URL=
MAIL_FROM="SitePlatform <bildirim@localhost>"
# Panelde ve hatırlatma e-postalarında müşteriye gösterilen yenileme iletişim bilgileri
SUPPORT_EMAIL=
SUPPORT_PHONE=

# --- Hata izleme (isteğe bağlı) ---
# Sentry veya kendi sunucunuzdaki GlitchTip projesinin DSN adresi; boşsa kapalı
SENTRY_DSN=
