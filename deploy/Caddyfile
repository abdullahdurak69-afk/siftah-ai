{
	email {$ACME_EMAIL}

	# Müşteri domain'lerine sertifika almadan önce uygulamaya sorulur:
	# sadece panelde eklenmiş ve DNS'i doğrulanmış domain'ler onay alır.
	on_demand_tls {
		ask http://app:3000/api/tls-izin?key={$CADDY_ASK_SECRET}
	}
}

# Platform: tanıtım sitesi ve panel. Müşteri siteleri platform subdomain'inde yayınlanmadığı için wildcard
# sertifika gerekmez; sertifikalar standart HTTP doğrulamasıyla alınır.
{$ROOT_DOMAIN}, app.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# www ve ikinci domain (ör. siftahai.com) ana adrese yönlenir
www.{$ROOT_DOMAIN}, {$ALT_DOMAIN}, www.{$ALT_DOMAIN} {
	redir https://{$ROOT_DOMAIN}{uri} permanent
}

# Müşterilerin kendi domain'leri (firmam.com, www.firmam.com, site.firmam.com...).
# Sertifika ilk ziyarette birkaç saniye içinde otomatik alınır ve yenilenir.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}

# HTTP'den gelen her isteği HTTPS'e yönlendir
http:// {
	redir https://{host}{uri} permanent
}
