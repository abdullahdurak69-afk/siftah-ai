# Caddy + Cloudflare DNS modülü. Platformun tüm subdomain'leri için tek bir wildcard sertifika
# (*.platformadi.com) almak Cloudflare DNS doğrulaması gerektirir.
FROM caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
