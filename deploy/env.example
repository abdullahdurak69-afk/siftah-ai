# Sunucudaki .env dosyası (proje kökünde). Bu dosyayı kopyalayıp doldurun:
#   cp deploy/env.example .env && nano .env
# Gizli değerler için: openssl rand -hex 24

# --- Platform ---
NEXT_PUBLIC_PLATFORM_NAME=SitePlatform
NEXT_PUBLIC_ROOT_DOMAIN=platformadi.com
ROOT_DOMAIN=platformadi.com

# --- Veritabanı (docker-compose içindeki "db" servisi) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgres://site_platform:POSTGRES_PASSWORD_BURAYA@db:5432/site_platform

# --- Giriş sistemi ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.platformadi.com

# --- Domain bağlama ve SSL ---
PLATFORM_SERVER_IP=
CADDY_ASK_SECRET=
CRON_SECRET=
ACME_EMAIL=
# Cloudflare > My Profile > API Tokens > "Edit zone DNS" şablonu, sadece platform domain'i için
CLOUDFLARE_API_TOKEN=

# --- E-posta (davet, şifre yenileme, abonelik hatırlatmaları) ---
# Herhangi bir SMTP sağlayıcısı: Resend (smtps://resend:API_KEY@smtp.resend.com:465), Brevo, Yandex...
# Boş bırakılırsa e-postalar gönderilmez, sunucu günlüğüne yazılır.
SMTP_URL=
MAIL_FROM="SitePlatform <bildirim@platformadi.com>"
# Panelde ve hatırlatma e-postalarında müşteriye gösterilen yenileme iletişim bilgileri
SUPPORT_EMAIL=
SUPPORT_PHONE=

# --- Hata izleme (isteğe bağlı) ---
# Sentry veya kendi sunucunuzdaki GlitchTip projesinin DSN adresi; boşsa kapalı
SENTRY_DSN=

# --- İlk süper admin (npm run db:seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
