# Sunucudaki .env dosyası (proje kökünde). Bu dosyayı kopyalayıp doldurun:
#   cp deploy/env.example .env && nano .env
# Gizli değerler için: openssl rand -hex 24

# --- Platform ---
NEXT_PUBLIC_PLATFORM_NAME="Siftah AI"
NEXT_PUBLIC_ROOT_DOMAIN=siftahai.com
ROOT_DOMAIN=siftahai.com
# Ana adrese yönlenen ikinci domain
ALT_DOMAIN=siftahai.com.tr

# --- Veritabanı (docker-compose içindeki "db" servisi) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgres://site_platform:POSTGRES_PASSWORD_BURAYA@db:5432/site_platform

# --- Giriş sistemi ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.siftahai.com

# --- Domain bağlama ve SSL ---
PLATFORM_SERVER_IP=
CADDY_ASK_SECRET=
CRON_SECRET=

# --- E-posta (davet, şifre yenileme, abonelik hatırlatmaları) ---
# Herhangi bir SMTP sağlayıcısı: Resend (smtps://resend:API_KEY@smtp.resend.com:465), Brevo, Yandex...
# Boş bırakılırsa e-postalar gönderilmez, sunucu günlüğüne yazılır.
SMTP_URL=
MAIL_FROM="Siftah AI <bildirim@siftahai.com>"
# Tanıtım sitesinde, panelde ve hatırlatma e-postalarında gösterilen iletişim bilgileri (tanıtım sitesine
# yansıması için imajın yeniden derlenmesi gerekir)
SUPPORT_EMAIL=
SUPPORT_PHONE=

# --- Arama motorları (tanıtım sitesi) ---
# Google Search Console ve Bing Webmaster Tools'un "HTML etiketi" doğrulamasındaki content değeri.
# Değiştirince imajı yeniden derleyin (update.sh): tanıtım sayfaları derlemede üretilir.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Hata izleme (isteğe bağlı) ---
# Sentry veya kendi sunucunuzdaki GlitchTip projesinin DSN adresi; boşsa kapalı
SENTRY_DSN=

# --- İlk süper admin (npm run db:seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
